# Copy this example to .env and set values locally, then restart Django.
# Process environment variables take precedence over .env.
# Only KEY=value lines and full-line comments are supported.
# Values are literal: no variable expansion or command execution.
OPENAI_API_KEY=
OPENAI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
DEFAULT_FROM_EMAIL=CodeStart <noreply@example.com>
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
